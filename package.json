    "coverage": "vitest run --coverage",
    "lint": "biome check --write .",
    "lint:ci": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/chrome": "^0.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
